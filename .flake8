[flake8]
extend-ignore = E301, E302, E303, E305, E306, E701, F403, F405
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    venv-capcut,
    build,
    dist,
    spikes,
    ignored,
    pyJianYingDraft/metadata
max-line-length = 140

# tool_registry imports the project's own modules, which cannot resolve until the
# sys.path.insert() above them has run. The ordering is deliberate, not an oversight.
per-file-ignores =
    tool_registry.py:E402
